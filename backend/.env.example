APP_NAME="Office Vision Intelligence Platform"
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
DATABASE_URL="sqlite:///./data/digital_twin.db"
CLIPS_DIRECTORY="./data/clips"

# Amazon Bedrock Configuration (Zero secrets; credentials loaded via AWS provider chain)
AWS_REGION=us-east-1
BEDROCK_REASONING_MODEL_ID=us.amazon.nova-lite-v1:0
BEDROCK_FAST_MODEL_ID=us.amazon.nova-micro-v1:0
BEDROCK_MULTIMODAL_MODEL_ID=us.amazon.nova-lite-v1:0
BEDROCK_CONNECT_TIMEOUT=10.0
BEDROCK_READ_TIMEOUT=60.0
BEDROCK_MAX_RETRIES=3

# Digital Twin Core Configuration
TWIN_TRACK_TTL_SECONDS=30.0
TWIN_SNAPSHOT_INTERVAL_EVENTS=100
TWIN_FLOORPLAN_SEED_PATH=src/twin/floorplan_seed.yaml
TWIN_PRUNE_INTERVAL_SECONDS=5.0

# Vision Geometry Configuration
VISION_CALIBRATION_DIR=data/calibration
VISION_TOPOLOGY_DIR=data/topology

# Vision Pipeline & Tracking Configuration
VISION_MODEL=yolo11n.pt
VISION_MODELS_DIR=data/models
VISION_DEVICE=cpu
VISION_TRACKER=bytetrack.yaml
VISION_CLIPS_DIR=data/clips
VISION_MIN_CONFIDENCE=0.35
VISION_PROCESS_FPS=5.0
VISION_BENCHMARKS_DIR=data/benchmarks

# Rules & Simulator Configuration
RULES_POLICY_PATH=data/rules/access_policy.yaml
SIMULATOR_SCENARIOS_DIR=data/scenarios
ACCESS_CONFIG_PATH=data/access/doors.yaml

