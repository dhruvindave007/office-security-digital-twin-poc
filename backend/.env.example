# Office Vision Twin - server configuration.
# `python scripts/setup.py` copies this to backend/.env and generates OVT_API_TOKEN for you.
# backend/.env is git-ignored: never commit it. Every value can also be set as an environment variable.

# --- Identity & access -------------------------------------------------------------------------
SITE_NAME="Demo office"                 # shown in the dashboard header
# Access token for the dashboard and API (>= 24 chars). Empty = only this computer may connect.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
OVT_API_TOKEN=
HOST=127.0.0.1                          # 0.0.0.0 exposes it on the network: requires OVT_API_TOKEN
PORT=8000
COOKIE_SECURE=false                     # true when served behind HTTPS (adds Secure cookie + HSTS)
SESSION_HOURS=12
DEBUG=false                             # never true in production (tracebacks in API errors)
APP_ENV=production

# --- Storage -----------------------------------------------------------------------------------
DATABASE_URL="sqlite:///./data/digital_twin.db"
EVIDENCE_DIR=data/evidence
EVIDENCE_MAX_TOTAL_MB=2000

# --- Your building -----------------------------------------------------------------------------
# See docs/USER_MANUAL.md "Model your building". Defaults are the bundled demo office.
TWIN_FLOORPLAN_SEED_PATH=src/twin/floorplan_seed.yaml
RULES_POLICY_PATH=data/rules/access_policy.yaml
ACCESS_CONFIG_PATH=data/access/doors.yaml
SIMULATOR_SCENARIOS_DIR=data/scenarios

# --- Live cameras (optional) -------------------------------------------------------------------
# A YAML list of RTSP/HTTP/file cameras; see data/sites/wisenet/live_rtsp.yaml for the format.
LIVE_CONFIG_PATH=
LIVE_AUTOSTART=false
VISION_MODEL=yolo11n.pt
VISION_DEVICE=cpu                       # cpu | intel:gpu | intel:npu | cuda:0
VISION_PROCESS_FPS=5.0
VISION_MIN_CONFIDENCE=0.35

# --- AI investigation on Amazon Bedrock (optional) ---------------------------------------------
# Credentials come only from the standard AWS chain (SSO, instance role, env). Never put keys here.
AWS_REGION=us-east-1
BEDROCK_INVESTIGATION_MODEL_ID=global.anthropic.claude-haiku-5-5
INVESTIGATION_DAILY_BUDGET_USD=1.0      # hard daily spend cap
AUTO_INVESTIGATE_ENABLED=false          # true = AI reviews HIGH/CRITICAL incidents by itself
