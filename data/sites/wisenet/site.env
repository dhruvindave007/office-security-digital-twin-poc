# Run the backend as the WiseNET building with live cameras. From backend/:
#   .\.venv\Scripts\python.exe -m uvicorn src.main:app --env-file ..\data\sites\wisenet\site.env --port 8000
DATABASE_URL=sqlite:///./data/wisenet_live.db
TWIN_FLOORPLAN_SEED_PATH=../data/sites/wisenet/floorplan_seed.yaml
RULES_POLICY_PATH=../data/sites/wisenet/access_policy.yaml
ACCESS_CONFIG_PATH=../data/sites/wisenet/doors.yaml
LIVE_CONFIG_PATH=../data/sites/wisenet/live.yaml
LIVE_AUTOSTART=true
VISION_MODEL=yolo11s_480_openvino_model
VISION_DEVICE=intel:gpu
TWIN_TRACK_TTL_SECONDS=10
